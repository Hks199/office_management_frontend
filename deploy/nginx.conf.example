# Install this in nginx's http context after adapting the domain, TLS paths,
# static root, and backend upstream. Serve the frontend and /api on one origin.
# Never replace a supplied Origin: cross-origin requests must still fail backend checks.
map $http_origin $sunvika_api_origin {
    default $http_origin;
    "" "https://office.example.com";
}

server {
    listen 80;
    server_name office.example.com;
    return 301 https://office.example.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name office.example.com;
    ssl_certificate /etc/ssl/sunvika/fullchain.pem;
    ssl_certificate_key /etc/ssl/sunvika/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /var/www/sunvika/dist;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: https://*.amazonaws.com; connect-src 'self' https://*.amazonaws.com; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https://*.amazonaws.com; frame-ancestors 'none'; worker-src 'self'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()" always;
    add_header Cache-Control "no-store" always;

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $sunvika_api_origin;
        proxy_set_header X-Forwarded-Proto $scheme;
        # This example has exactly one trusted proxy; do not preserve client-supplied chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_hide_header X-Powered-By;
        client_max_body_size 1m;
    }
    location / { try_files $uri $uri/ /index.html; }
}

